[import = Layout: "@/layouts/Layout.arcm" !]

${ export const first = "svg"; }$

runtime ${
  import { signal } from "arcmoon/reactive";
  import { svgTagNames } from "svg-tag-names";
  import { pick } from "../src/scripts/pick.js";
  const tag = signal(first);
  const count = svgTagNames.length;
}$

[Layout = page: "browser-code"]
  [section = class: "demo"]
    [h2]An npm package in the browser (listed in bundle)[end]
    [div = class: "row"]
      [code = class: "big"]<runtime ${ tag() }$>[end]
      [button = class: "btn primary", onclick: runtime ${ () => tag(pick(svgTagNames)) }$]Random SVG tag[end]
    [end]
    [p = class: "muted note"]One of runtime ${ count }$ names from svg-tag-names, picked by a local module (src/scripts/pick.js).[end]
  [end]
  [section = class: "demo"]
    [h2]A [code]\[script = src\][end] file[end]
    [p]Local time: [strong][time = id: "clock"]…[end][end][end]
  [end]
  [script = src: "../src/scripts/clock.js" !]
[end:Layout]

[style]
  .big { font-size: 1.3rem; padding: 0.5rem 1rem; }
  .note { margin-top: 1rem; }
[end:style]
