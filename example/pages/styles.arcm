[import = Layout: "@/layouts/Layout.arcm" !]
[import = Card: "@/components/Card.arcm" !]
[import = Note: "@/components/Note.arcm" !]

${ const swatches = ["#6c5ce7", "#0984e3", "#00b894", "#fdcb6e", "#e17055"]; }$

runtime ${
  import { signal } from "arcmoon/reactive";
  const size = signal(40);
  const radius = signal(20);
}$

[Layout = page: "styles"]
  [section = class: "demo"]
    [h2]Scoped: both components use class "title"[end]
    [div = class: "grid"]
      [Card = title: "Card title"]Styled by Card.arcm.[end]
      [Note = title: "Note title"]Styled by Note.arcm.[end]
    [end]
  [end]

  [section = class: "demo"]
    [h2]CSS variables as props: --swatch from build-time values[end]
    [ul = class: "swatches", --gap: "0.75rem"]
      [for-each = ${ swatches }$, as: "color"][li = --swatch: ${ color }$][span][end][code]${ color }$[end][end][end]
    [end]
  [end]

  [section = class: "demo"]
    [h2]Live styles: a --size prop and a live [code]\[style\][end][end]
    [div = class: "controls"]
      [label]Size [input = type: "range", min: 20, max: 120, value: 40, oninput: runtime ${ (e) => size(Number(e.target.value)) }$ !] [output]runtime ${ size() }$px[end][end]
      [label]Radius [input = type: "range", min: 0, max: 50, value: 20, oninput: runtime ${ (e) => radius(Number(e.target.value)) }$ !] [output]runtime ${ radius() }$%[end][end]
    [end]
    [div = class: "stage"][div = class: "shape", --size: runtime ${ size() + "px" }$][end][end]
    # A [style] with a live value stays where it is; the browser rewrites it when radius changes
    [style]
      .shape { border-radius: runtime ${ radius() }$%; }
    [end:style]
  [end]
[end:Layout]

[style]
  .swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr)); gap: var(--gap); list-style: none; padding: 0; margin: 0; }
  .swatches li { display: flex; align-items: center; gap: 0.6rem; padding: 0.5rem; border: 1px solid var(--border); border-radius: 10px; }
  .swatches span { width: 2rem; height: 2rem; border-radius: 8px; background: var(--swatch); flex: none; }
  .controls { display: grid; gap: 0.75rem; max-width: 28rem; }
  .controls label { display: grid; grid-template-columns: 4rem 1fr 3.5rem; align-items: center; gap: 0.75rem; font-weight: 600; }
  .controls input { accent-color: var(--brand); width: 100%; }
  .controls output { color: var(--muted); font-variant-numeric: tabular-nums; text-align: right; }
  .stage { display: grid; place-items: center; height: 10rem; margin-top: 1rem; border-radius: 10px; background: var(--bg); }
  .shape { width: var(--size, 40px); height: var(--size, 40px); background: linear-gradient(135deg, var(--brand), #e17055); }
[end:style]
