[import = Layout: "@/layouts/Layout.arcm" !]

[Layout = page: "syntax"]
  [section = class: "demo"]
    [h2]Escapes[end]
    [p]\[not a block\], a \# hash, a \: colon, and a literal \${ }$.[end]
  [end]

  ###
    A block comment.
    Comments never reach the HTML.
  ###
  [section = class: "demo"]
    [h2]Raw body: arcm-raw[end]
    [pre = arcm-raw: true, arcm-syntax: "arcm"][Card = title: "Hi", accent: "#e17055"]
  Written as text: ${ not run }$ # not a comment
\[end:Card][end]
  [end]

  [section = class: "demo"]
    [h2]Numbers and booleans in props[end]
    [div = class: "row"]
      [input = class: "field", type: "number", value: 42, min: 0, max: 100 !]
      [label = class: "check"][input = type: "checkbox", checked: true !] checked: true[end]
      [label = class: "check"][input = type: "checkbox", disabled: true !] disabled: true[end]
    [end]
  [end]
[end:Layout]

[style]
  pre { overflow-x: auto; padding: 1rem 1.1rem; border-radius: 10px; background: #16151f; color: #e6e4f5; line-height: 1.5; }
  .check { display: inline-flex; align-items: center; gap: 0.4rem; }
  .check input { accent-color: var(--brand); width: 1.1rem; height: 1.1rem; }
  input[type="number"].field { max-width: 7rem; }
[end:style]
