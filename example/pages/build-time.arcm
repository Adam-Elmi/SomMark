[import = Layout: "@/layouts/Layout.arcm" !]
${
  import { readFile } from "node:fs/promises";
  import { htmlTagNames } from "html-tag-names";
  const notes = await readFile(new URL("../src/data/notes.txt", import.meta.url), "utf8");
  const built = new Date().toISOString().slice(0, 16).replace("T", " ");
}$

[Layout = page: "build-time"]
  [section = class: "demo"]
    [h2]Values computed while building[end]
    [div = class: "stats"]
      [div][strong]${ htmlTagNames.length }$[end][span]HTML tags, from the npm package html-tag-names[end][end]
      [div][strong]${ ArcMoon.version }$[end][span]ArcMoon.version[end][end]
      [div][strong]${ built }$[end][span]build time (UTC)[end][end]
    [end]
  [end]
  [section = class: "demo"]
    [h2]A file read with node:fs[end]
    [blockquote]${ notes.trim() }$[end]
  [end]
  [section = class: "demo"]
    [h2]Raw HTML[end]
    [p]${ { raw: "<em>This is HTML</em> returned as <code>{ raw }</code>, not escaped text." } }$[end]
  [end]
[end:Layout]

[style]
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 1rem; }
  .stats div { display: flex; flex-direction: column; padding: 1rem; border-radius: 10px; background: var(--bg); }
  .stats strong { font-size: 1.5rem; }
  .stats span { color: var(--muted); font-size: 0.9rem; }
  blockquote { margin: 0; padding: 0.9rem 1.1rem; border-left: 4px solid var(--brand); background: var(--brand-soft); border-radius: 0 10px 10px 0; }
[end:style]
