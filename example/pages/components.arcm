[import = Layout: "@/layouts/Layout.arcm" !]
[import = Card: "@/components/Card.arcm" !]

[Layout = page: "components"]
  [section = class: "demo"]
    [h2]Props and slot content[end]
    [div = class: "grid"]
      [Card = title: "Fast", accent: "#0984e3", tag: "props"]Compiles to plain HTML.[end]
      [Card = title: "Small", accent: "#00b894"]Only your runtime code is shipped.[end]
      [Card = title: "Safe", accent: "#e17055", tag: "slot"]Templates you didn't write are checked first.[end]
    [end]
  [end]
  [section = class: "demo"]
    [h2]Slot fallback (no body)[end]
    [div = class: "grid"][Card = title: "Empty card" !][end]
  [end]
[end:Layout]
