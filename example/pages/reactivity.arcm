[import = Layout: "@/layouts/Layout.arcm" !]
[import = Counter: "@/components/Counter.arcm" !]

runtime ${
  import { signal, computed } from "arcmoon/reactive";
  const text = signal("");
  const words = computed(() => text().trim().split(/\s+/).filter(Boolean).length);
  const on = signal(false);
}$

[Layout = page: "reactivity"]
  [section = class: "demo"]
    [h2]Counters: each use has its own state[end]
    [div = class: "grid"]
      [Counter = label: "Coffee", start: 2, max: 5 !]
      [Counter = label: "Pages read", max: 10 !]
    [end]
  [end]

  [section = class: "demo"]
    [h2]Live text and computed values[end]
    [input = class: "field", placeholder: "Type something", oninput: runtime ${ (e) => text(e.target.value) }$ !]
    [p = class: "echo"]runtime ${ text() || "…" }$[end]
    [p = class: "muted"]runtime ${ text().length }$ characters · runtime ${ words() }$ words[end]
  [end]

  [section = class: "demo"]
    [h2]Live attributes and classes[end]
    [div = class: "row"]
      [button = class: "btn", aria-pressed: runtime ${ String(on()) }$, onclick: runtime ${ () => on(!on()) }$]Turn runtime ${ on() ? "off" : "on" }$[end]
      [div = class: runtime ${ on() ? "lamp lit" : "lamp" }$, title: runtime ${ on() ? "On" : "Off" }$][end]
    [end]
  [end]
[end:Layout]

[style]
  .echo { font-size: 1.5rem; font-weight: 700; margin: 1rem 0 0.25rem; overflow-wrap: anywhere; }
  .lamp { width: 2.5rem; height: 2.5rem; border-radius: 50%; background: var(--border); transition: background 0.2s, box-shadow 0.2s; }
  .lamp.lit { background: #fdcb6e; box-shadow: 0 0 24px #fdcb6e; }
[end:style]