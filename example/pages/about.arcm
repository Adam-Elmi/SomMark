[import = Layout: "@/layouts/Layout.arcm" !]

${
  import { readFile } from "node:fs/promises";
  const notes = await readFile(new URL("../src/data/notes.txt", import.meta.url), "utf8");
  const theme = { brand: "#6c5ce7" };
}$

[Layout = title: "About"]
  [h1]About[end]
  [p]${ notes.trim() }$[end]

  ###
    A block comment.
    Comments are removed from the HTML.
  ###
  [h2]Escapes[end]
  [p]Plain text: \[not a block\], a \# hash, a \: colon.[end]

  [h2]Raw body[end]
  [pre = arcm-raw: true, arcm-syntax: "arcm"][Card = title: "Hi"]Body\[end:Card] ${ not run }$[end]

  [h2]Raw HTML from \${ }$[end]
  [p]${ { raw: "<em>This is HTML</em>, not text." } }$[end]

  [h2]CSS variables as props[end]
  [ul = class: "list", --gap: "1.5rem"][li]one[end][li]two[end][li]three[end][end]

[end:Layout]

[style]
  :root { --brand: ${ theme.brand }$; }
  h1 { color: var(--brand); padding-right: 2.5rem; background: url("../src/assets/moon.svg") no-repeat right center / 2rem; display: inline-block; }
  .list { display: flex; gap: var(--gap); list-style: none; padding: 0; }
[end:style]
