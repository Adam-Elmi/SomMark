[import = Layout: "@/layouts/Layout.arcm" !]
[import = Tag: "@/components/Tag.arcm" !]

runtime ${
  import { signal } from "arcmoon/reactive";

  // A single ref: one element
  const input = ArcMoon.ref(ArcMoon.defineRef("name"));
  ArcMoon.ref(ArcMoon.defineRef("focus")).onclick = () => input.focus();
  ArcMoon.ref(ArcMoon.defineRef("clear")).onclick = () => { input.value = ""; input.focus(); };

  // A shared ref: every Tag's button, collected from all the components
  const selected = signal("none");
  const tags = ArcMoon.refs(ArcMoon.defineRef("tag"));
  for (const t of tags) {
    t.onclick = () => {
      t.setAttribute("aria-pressed", String(t.getAttribute("aria-pressed") !== "true"));
      const on = tags.filter((x) => x.getAttribute("aria-pressed") === "true").map((x) => x.textContent);
      selected(on.join(", ") || "none");
    };
  }
}$

[Layout = page: "refs"]
  [section = class: "demo"]
    [h2]A single ref: arcm-ref[end]
    [div = class: "row"]
      [input = class: "field", arcm-ref: "name", placeholder: "Your name" !]
      [button = class: "btn primary", arcm-ref: "focus"]Focus[end]
      [button = class: "btn", arcm-ref: "clear"]Clear[end]
    [end]
  [end]
  [section = class: "demo"]
    [h2]A shared ref across components: arcm-shared-ref[end]
    [div = class: "row"]
      [for-each = ${ ["html", "css", "javascript", "node", "esbuild"] }$, as: "name"][Tag = name: ${ name }$ !][end]
    [end]
    [p = class: "muted picked"]Selected: [strong]runtime ${ selected() }$[end][end]
  [end]
[end:Layout]

[style]
  .picked { margin-top: 1rem; }
[end:style]
