[import = Layout: "@/layouts/Layout.arcm" !]
${ import pages from "../src/data/pages.json"; }$

[Layout = page: "index"]
  [div = class: "intro"]
    [div]
      [h1]ArcMoon examples[end]
      [p = class: "muted"]Every feature, one page each.[end]
    [end]
    [div = class: "moon-art", aria-hidden: "true"][end]
  [end]
  [div = class: "grid"]
    [for-each = ${ pages }$, as: "p"]
      [a = class: "tile", href: ${ `./${p.file}.html` }$]
        [span = class: "n"]${ String(i + 1).padStart(2, "0") }$[end]
        [strong]${ p.title }$[end]
        [span = class: "muted"]${ p.about }$[end]
      [end]
    [end]
  [end]
[end:Layout]

[style]
  .intro { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.75rem; }
  .intro h1 { margin: 0 0 0.25rem; }
  .moon-art { width: clamp(3.5rem, 12vw, 6rem); aspect-ratio: 1; flex: none; }
  .tile {
    display: flex; flex-direction: column; gap: 0.3rem; padding: 1.1rem 1.2rem;
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
    color: var(--fg); text-decoration: none; transition: transform 0.15s, border-color 0.15s, box-shadow 0.15s;
  }
  .tile:hover { transform: translateY(-3px); border-color: var(--brand); box-shadow: var(--shadow); }
  .tile strong { font-size: 1.1rem; }
  .tile .n { color: var(--brand); font-weight: 800; font-size: 0.85rem; }
  .tile .muted { font-size: 0.92rem; }
[end:style]
