[import = Layout: "@/layouts/Layout.arcm" !]
${ import projects from "../src/data/projects.json"; }$

[Layout = page: "loops"]
  [section = class: "demo"]
    [h2]A table from JSON[end]
    [div = class: "scroll"]
      [table]
        [thead][tr][th]\#[end][th]Name[end][th]Tag[end][th]Features[end][end][end]
        [tbody]
          [for-each = ${ projects }$, as: "project"]
            [tr]
              [td = class: "muted"]${ i + 1 }$[end]
              [td][strong = style: ${ `color: ${project.color}` }$]${ project.name }$[end][end]
              [td]${ project.tag ?? "—" }$[end]
              [td]
                [for-each = ${ project.features }$, as: "f"][span = class: "chip"]${ f }$[end][end]
                [for-each = ${ project.features.length ? [] : [1] }$][span = class: "muted"]none[end][end]
              [end]
            [end]
          [end]
        [end]
      [end]
    [end]
  [end]
  [section = class: "demo"]
    [h2]Numbers from an expression[end]
    [div = class: "row"][for-each = ${ Array.from({ length: 12 }, (_, n) => (n + 1) ** 2) }$, as: "sq"][span = class: "chip"]${ sq }$[end][end][end]
  [end]
[end:Layout]

[style]
  .scroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; min-width: 32rem; }
  th, td { text-align: left; padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--border); vertical-align: middle; }
  th { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
  .chip { display: inline-block; margin: 0.15rem 0.3rem 0.15rem 0; padding: 0.15rem 0.6rem; border-radius: 99px; background: var(--brand-soft); color: var(--brand); font-size: 0.85rem; font-weight: 600; }
[end:style]
