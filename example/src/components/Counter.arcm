# Counter: exported values start the signal; live text, class, disabled, events and --fill
${
  const { label = "Counter", start = 0, max = 10 } = ArcMoon.props();
  export const initial = start;
  export const limit = max;
}$
runtime ${
  import { signal, computed } from "arcmoon/reactive";
  const count = signal(initial);
  const full = computed(() => count() >= limit);
}$
[div = class: "counter"]
  [div = class: "head"]
    [span = class: "label"]${ label }$[end]
    [span = class: runtime ${ full() ? "value full" : "value" }$]runtime ${ count() }$[span = class: "max"] / ${ max }$[end][end]
  [end]
  [div = class: "track"][div = class: "fill", --fill: runtime ${ (count() / limit) * 100 + "%" }$][end][end]
  [div = class: "actions"]
    [button = class: "btn", aria-label: "Decrease", disabled: runtime ${ count() <= 0 }$, onclick: runtime ${ () => count(count() - 1) }$]−[end]
    [button = class: "btn primary", aria-label: "Increase", disabled: runtime ${ full() }$, onclick: runtime ${ () => count(count() + 1) }$]+[end]
    [button = class: "btn reset", onclick: runtime ${ () => count(initial) }$]Reset[end]
  [end]
[end]
[style]
  .counter { background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  .head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.6rem; }
  .label { font-weight: 600; }
  .value { font-size: 1.5rem; font-weight: 800; font-variant-numeric: tabular-nums; }
  .max { font-size: 0.9rem; font-weight: 500; color: var(--muted); }
  .full { color: #e17055; }
  .track { height: 8px; border-radius: 99px; background: var(--border); overflow: hidden; }
  .fill { height: 100%; width: var(--fill, 0%); background: linear-gradient(90deg, var(--brand), #e17055); border-radius: inherit; transition: width 0.25s; }
  .actions { display: flex; gap: 0.5rem; margin-top: 0.9rem; }
  .actions .btn { flex: 1; }
  .reset { flex: 1.4; }
[end:style]
