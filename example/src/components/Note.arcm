# Note: also uses class "title", styled differently; scoping keeps them apart
${ const { title } = ArcMoon.props(); }$
[aside = class: "note"]
  [p = class: "title"]${ title }$[end]
  [slot!]
[end]
[style]
  .note { border-left: 4px solid #fdcb6e; background: color-mix(in srgb, #fdcb6e 14%, transparent); border-radius: 0 10px 10px 0; padding: 0.9rem 1.1rem; }
  .title { margin: 0 0 0.25rem; font-style: italic; font-weight: 700; color: #d68910; }
[end:style]
