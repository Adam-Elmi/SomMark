# Card: a title prop, a --accent CSS variable, slot content with a fallback
${ const { title, accent = "#6c5ce7", tag } = ArcMoon.props(); }$
[article = class: "card", --accent: ${ accent }$]
  [div = class: "top"]
    [h3 = class: "title"]${ title }$[end]
    # No [if]: a for-each over zero or one item
    [for-each = ${ tag ? [tag] : [] }$, as: "label"][span = class: "badge"]${ label }$[end][end]
  [end]
  [p][slot]No description.[end][end]
[end]
[style]
  .card {
    position: relative; overflow: hidden;
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 1.25rem 1.25rem 1.1rem;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .card::before { content: ""; position: absolute; inset: 0 0 auto; height: 4px; background: var(--accent); }
  .card:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .top { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.4rem; }
  .title { margin: 0; font-size: 1.05rem; color: var(--accent); }
  .badge {
    font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent);
    padding: 0.15rem 0.5rem; border-radius: 99px;
  }
  p { margin: 0; color: var(--muted); font-size: 0.95rem; }
[end:style]
