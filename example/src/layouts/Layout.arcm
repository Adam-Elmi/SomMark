# Layout: the page's title and description come from src/data/pages.json
${
  import pages from "../data/pages.json";
  const { page = "index" } = ArcMoon.props();
  const at = pages.findIndex((p) => p.file === page);
  const current = pages[at];
  const title = current ? current.title : "ArcMoon examples";
  const prev = at > 0 ? [pages[at - 1]] : [];
  const next = current && at < pages.length - 1 ? [pages[at + 1]] : [];
}$
[doctype!]
[html = lang: "en"]
  [head]
    [meta = charset: "utf-8" !]
    [meta = name: "viewport", content: "width=device-width, initial-scale=1" !]
    [meta = name: "description", content: ${ current ? current.about : "Every ArcMoon feature, one page each." }$ !]
    [title]${ title }$ · ArcMoon[end]
    [link = rel: "stylesheet", href: "../styles/main.css" !]
    # Inline [script] is written as it is: sets the theme before the page paints
    [script]try { const t = localStorage.getItem("theme"); if (t ? t === "dark" : matchMedia("(prefers-color-scheme: dark)").matches) document.documentElement.classList.add("dark"); } catch {}[end]
  [end]
  [body]
    [header = class: "site"]
      [div = class: "container bar"]
        [a = class: "logo", href: "./index.html"]
          [svg = viewBox: "0 0 24 24", width: 24, height: 24, aria-hidden: "true"][path = fill: "currentColor", d: "M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" !][end]
          ArcMoon
        [end]
        [a = class: "all", href: "./index.html", aria-current: ${ current ? false : "page" }$]All examples[end]
        [button = class: "theme", arcm-ref: "theme", aria-label: "Switch theme"]☾[end]
      [end]
    [end]

    [main = class: "container"]
      [for-each = ${ current ? [current] : [] }$, as: "p"]
        [div = class: "page-head"]
          [span = class: "step"]${ at + 1 }$ / ${ pages.length }$[end]
          [h1]${ p.title }$[end]
          [p]${ p.about }$[end]
        [end]
      [end]
      [slot!]
      [nav = class: "pager", aria-label: "Examples"]
        [for-each = ${ prev }$, as: "p"][a = class: "prev", href: ${ `./${p.file}.html` }$][small]Previous[end]${ p.title }$[end][end]
        [for-each = ${ next }$, as: "p"][a = class: "next", href: ${ `./${p.file}.html` }$][small]Next[end]${ p.title }$[end][end]
      [end]
    [end]

    [footer][div = class: "container"]ArcMoon ${ ArcMoon.version }$[end][end]
  [end]
[end]

runtime ${
  const root = document.documentElement;
  const button = ArcMoon.ref(ArcMoon.defineRef("theme"));
  const show = () => {
    const dark = root.classList.contains("dark");
    button.textContent = dark ? "☀" : "☾";
    button.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
  };
  show();
  button.onclick = () => {
    const dark = root.classList.toggle("dark");
    try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch {}
    show();
  };
}$

# Scoped: only the layout's own elements
[style]
  header.site {
    position: sticky; top: 0; z-index: 10;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .bar { display: flex; align-items: center; gap: 1rem; min-height: 3.75rem; }
  .logo { display: flex; align-items: center; gap: 0.5rem; font-weight: 800; font-size: 1.1rem; color: var(--brand); text-decoration: none; margin-right: auto; }
  :global(.dark) .logo svg { filter: drop-shadow(0 0 6px var(--brand)); }
  .all { padding: 0.4rem 0.8rem; border-radius: 8px; color: var(--muted); font-weight: 600; text-decoration: none; }
  .all:hover, .all[aria-current="page"] { color: var(--brand); background: var(--brand-soft); }
  .theme {
    width: 2.4rem; height: 2.4rem; border-radius: 50%;
    border: 1px solid var(--border); background: var(--surface); color: var(--fg);
    font-size: 1.05rem; cursor: pointer;
  }
  .theme:hover { border-color: var(--brand); }
  main { flex: 1; padding-block: 2rem 3rem; }
  .page-head { margin-bottom: 1.5rem; }
  .step { color: var(--brand); font-weight: 700; font-size: 0.85rem; letter-spacing: 0.05em; }
  .page-head h1 { margin: 0.25rem 0 0.5rem; }
  .page-head p { color: var(--muted); font-size: 1.1rem; max-width: 40rem; }
  .pager { display: flex; gap: 1rem; margin-top: 2.5rem; }
  .pager a {
    flex: 1; display: flex; flex-direction: column; padding: 0.9rem 1.1rem;
    border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface);
    color: var(--fg); font-weight: 700; text-decoration: none;
  }
  .pager a:hover { border-color: var(--brand); }
  .pager small { color: var(--muted); font-weight: 500; }
  .next { text-align: right; margin-left: auto; }
  footer { border-top: 1px solid var(--border); padding-block: 1.25rem; color: var(--muted); font-size: 0.85rem; text-align: center; }
  @media (max-width: 520px) { .pager { flex-direction: column; } .next { text-align: left; margin-left: 0; } }
[end:style]
