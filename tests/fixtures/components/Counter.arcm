${ const { start = 0 } = ArcMoon.props(); export const initial = start; }$
runtime ${
  import { signal, computed } from "arcmoon/reactive";
  const count = signal(initial);
  const hot = computed(() => count() > 11);
  ArcMoon.ref(ArcMoon.defineRef("btn")).dataset.ready = "yes";
}$
[button = arcm-ref: "btn", class: runtime ${ hot() ? "hot" : "cold" }$, onclick: runtime ${ () => count(count() + 1) }$]runtime ${ count() }$[end:button]
